{
  "name": "@uncarved/jade-api",
  "version": "1.1.0",
  "description": "Types and definePlugin for writing jade plugins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MochiNek0/uncarved.git",
    "directory": "packages/jade-api"
  },
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./services": {
      "bun": "./src/services.ts",
      "types": "./dist/services.d.ts",
      "import": "./dist/services.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/require-bun-publish.mjs && bun run build"
  },
  "peerDependencies": {
    "uncarved": "workspace:^"
  }
}
