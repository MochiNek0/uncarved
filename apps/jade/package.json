{
  "name": "@uncarved/jade",
  "version": "0.2.1",
  "description": "A coding agent harness built on the uncarved kernel: a small stable host core, everything else is a plugin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MochiNek0/uncarved.git",
    "directory": "apps/jade"
  },
  "keywords": [
    "agent",
    "coding-agent",
    "cli",
    "llm",
    "uncarved"
  ],
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "jade": "./bin/jade.js"
  },
  "files": [
    "assets",
    "bin",
    "dist",
    "src",
    "plugins",
    "plugins-dist",
    "sdk"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/build-plugins.mjs",
    "prepublishOnly": "node ../../scripts/require-bun-publish.mjs && bun run build"
  },
  "dependencies": {
    "@uncarved/jade-api": "workspace:*",
    "@uncarved/provider-anthropic": "workspace:*",
    "@uncarved/provider-openai-compat": "workspace:*",
    "@uncarved/provider-openai-responses": "workspace:*",
    "@uncarved/store-jsonl": "workspace:*",
    "htmlparser2": "^10.0.0",
    "ink": "7.1.1",
    "picomatch": "^4.0.3",
    "react": "^19.2.0",
    "string-width": "^8.2.0",
    "uncarved": "workspace:*",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.2",
    "@types/react": "^19.2.0"
  }
}
