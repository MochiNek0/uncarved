{
  "name": "uncarved-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter uncarved build && bun run --filter '@uncarved/*' build",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@uncarved/provider-anthropic": "workspace:*",
    "@uncarved/plugin-stdio": "workspace:*",
    "@uncarved/provider-openai-compat": "workspace:*",
    "@uncarved/provider-openai-responses": "workspace:*",
    "@uncarved/store-jsonl": "workspace:*",
    "typescript": "^7.0.2",
    "uncarved": "workspace:*"
  }
}
