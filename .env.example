# jade 的模型配置：复制到 ~/.jade/.env（或 $JADE_HOME/.env）后填写。三选一，优先级从上到下。
# 在仓库里直接运行 examples 时，bun 也会自动加载仓库根目录的 .env。

# OpenAI Responses API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5

# 任意兼容 /chat/completions 的服务（三项都要填）
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=
# 可选：合并进每次请求体的 JSON，例如开启思考（字段名因服务而异）
# OPENAI_COMPAT_EXTRA_BODY={"enable_thinking":true}

# Claude
# ANTHROPIC_API_KEY=
