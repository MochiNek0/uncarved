# jade 的模型配置：复制到 ~/.jade/.env（或 $JADE_HOME/.env）后填写；也可以在 jade 里用 /model 配置，会写进这个文件。
# 三选一；没有 JADE_PROVIDER 时优先级从上到下。
# 在仓库里直接运行 examples 时，bun 也会自动加载仓库根目录的 .env。

# 指定用哪一种：openai-compat | openai | anthropic
# JADE_PROVIDER=

# 每次回复的输出上限（token）。token 数都可以写成 32000、64K、1M 这样（K 是千、M 是百万）。不设时 Claude 用 64000，其他服务用服务端默认值，有的只有 4096，带思考的模型很容易用完
# JADE_MAX_TOKENS=32000

# 思考力度。Claude：low | medium | high | xhigh | max，不设时为 high；OpenAI：minimal | low | medium | high，不设时用服务端默认值。
# openai-compat 没有统一的字段，用 OPENAI_COMPAT_EXTRA_BODY 设置
# JADE_EFFORT=high

# 新会话默认的权限模式：ask | auto | plan | yolo。在会话里用 shift+tab 或 /mode 切换时会自动写进来（yolo 除外）
# JADE_MODE=ask

# 模型的上下文窗口（token）。不设时按模型名推断，认不出的按 128000 算
# JADE_CONTEXT_WINDOW=256K
# 压缩阈值（token）。不设时取上下文窗口的 80%，并给一次回复的输出留出位置
# JADE_COMPACT_TOKENS=

# OpenAI Responses API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5

# 任意兼容 /chat/completions 的服务（三项都要填）
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=
# 可选：合并进每次请求体的 JSON，例如开启思考（字段名因服务而异）
# OPENAI_COMPAT_EXTRA_BODY={"enable_thinking":true}

# Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# 网络搜索（web_search 工具）。一个 key 都不设时只有 web_fetch，没有 web_search
# 配了 key 的服务按顺序试，一个失败换下一个；web_fetch 先直接下载，被拦（403/429/5xx）、连不上或只拿到 JS 外壳时再经这些服务读
# 也可以在 jade 里用 /search 设置（写进 $JADE_HOME/.env，当前会话立即生效）
# TINYFISH_API_KEY=     # 免费，只限速        https://www.tinyfish.ai/pricing
# ANYSEARCH_API_KEY=    # 每天 1000 次        https://anysearch.com/pricing
# TAVILY_API_KEY=       # 每月 1000 credits   https://tavily.com
# EXA_API_KEY=          # 每月 $10 额度       https://dashboard.exa.ai
# FIRECRAWL_API_KEY=    # 每月 1000 credits   https://www.firecrawl.dev
# JINA_API_KEY=         # 一次性 1000 万 token https://jina.ai/api-key
# 调用顺序和范围（逗号分隔；不设时用所有配了 key 的服务，按上面的顺序）
# JADE_SEARCH=tavily,tinyfish
# 每次搜索返回的条数，1-20，默认 10
# JADE_SEARCH_RESULTS=10
# web_fetch / web_search 走代理时设置（bun 的 fetch 会读取）
# HTTPS_PROXY=http://127.0.0.1:7890
